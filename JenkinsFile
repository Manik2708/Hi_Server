pipeline{
    agent any
    tools{
        nodejs 'nodejs'
    }
    stages{
        stage('Setup docker compose'){
            steps{
                dir('scripts'){
                   sh 'chmod +x docker_compose_up.sh'
                   sh './docker_compose_up.sh' 
                }
            }
        }
        stage('Install dependencies'){
          steps{
                sh 'npm install'
                echo 'Dependencies installed successfully'
          }
        }
        stage('Check formatting'){
           steps {
                sh 'npm run format:check'
           }
        }
        stage('Check Containers health'){
           steps{
            script{
             try{
                dir('scripts'){
                    sh 'chmod +x container_heath_check.sh'
                    sh './container_heath_check.sh'
                }
            }catch(e){
                dir('scripts'){
                    sh 'chmod +x docker_compose_up.sh'
                    sh 'chmod +x docker_compose_down.sh'
                    sh './docker_compose_down.sh'
                    sh './docker_compose_up.sh'
                }
            }
           }
           }
        }
        stage('Run tests'){
            steps{
                sh 'npm run test:e2e'
            }
        }
        stage('Close testing enviornment'){
            steps{
                dir('scripts'){
                    sh 'chmod +x docker_compose_down.sh'
                    sh './docker_compose_down.sh'
                }
            }
        }
        stage('Check for circular dependencies'){
            sh 'npx madge --circular --extensions ts ./'
        }
        stage('Start docker compose for build'){
            steps{
                sh 'docker compose up -d --no-color --wait'
            }
        }
        stage('Build server'){
            steps{
                sh 'chmod +rwx .env'
                sh 'sed -i \'s/RUNNING_ON_DOCKER=false/RUNNING_ON_DOCKER=true/g\' .env'
                sh 'npm run build'
            }
        }
    }
    post{
       always{
            sh 'docker compose down'
       } 
    }
}