pipeline{
    agent any
    tools{
        nodejs 'nodejs'
    }
    stages{
        stage('Git checkout'){
            steps{
                git branch: 'develop', changelog: false, poll: false, url: 'https://github.com/Manik2708/Hi_Server'
            }
        }
        stage('Setup docker compose'){
            steps{
                dir('scripts'){
                   sh 'chmod +x docker_compose_up.sh'
                   sh './docker_compose_up.sh' 
                }
            }
        }
        stage('Install dependencies'){
          steps{
                sh 'npm install'
                echo 'Dependencies installed successfully'
          }
        }
        stage('Check formatting'){
           steps {
                sh 'npm run format:check'
           }
        }
        stage('Check Containers health'){
           steps{
            script{
             try{
                dir('scripts'){
                    sh 'chmod +x container_heath_check.sh'
                    sh './container_heath_check.sh'
                }
            }catch(e){
                dir('scripts'){
                    sh 'chmod +x docker_compose_up.sh'
                    sh 'chmod +x docker_compose_down.sh'
                    sh './docker_compose_down.sh'
                    sh './docker_compose_up.sh'
                }
            }
           }
           }
        }
        stage('Run tests'){
            steps{
                sh 'npm run test:e2e'
            }
        }        
    }
    post{
       always{
        dir('scripts'){
                sh 'chmod +x docker_compose_down.sh'
                sh './docker_compose_down.sh'
            }
       } 
    }
}